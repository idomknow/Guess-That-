rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Validation Blueprint: LeaderboardEntry
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
        'userId', 'displayName', 'editorialTitle', 'score', 'streak',
        'badgesCount', 'tokens', 'unlockedBadges', 'unlockedRewards',
        'visibility', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'displayName', 'editorialTitle', 'score', 'streak',
        'badgesCount', 'tokens', 'unlockedBadges', 'unlockedRewards',
        'visibility', 'createdAt', 'updatedAt'
      ]) &&
      data.userId == request.auth.uid &&
      data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
      data.editorialTitle is string && data.editorialTitle.size() >= 1 && data.editorialTitle.size() <= 60 &&
      data.score is int && data.score >= 0 && data.score <= 10000000 &&
      data.streak is int && data.streak >= 0 && data.streak <= 10000 &&
      data.badgesCount is int && data.badgesCount >= 0 && data.badgesCount <= 20 &&
      data.tokens is int && data.tokens >= 0 && data.tokens <= 1000000 &&
      data.unlockedBadges is list && data.unlockedBadges.size() <= 20 &&
      (data.unlockedBadges.size() == 0 || (data.unlockedBadges[0] is string && data.unlockedBadges[0].size() <= 64)) &&
      data.unlockedRewards is list && data.unlockedRewards.size() <= 20 &&
      (data.unlockedRewards.size() == 0 || (data.unlockedRewards[0] is string && data.unlockedRewards[0].size() <= 64)) &&
      data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: MultiplayerRoom
    function isValidMultiplayerRoom(data) {
      return data.keys().hasAll([
        'roomId', 'roomCode', 'hostId', 'hostName', 'hostScore',
        'guestId', 'guestName', 'guestScore', 'category', 'roundIndex',
        'status', 'visibility', 'lastEvent', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'roomId', 'roomCode', 'hostId', 'hostName', 'hostScore',
        'guestId', 'guestName', 'guestScore', 'category', 'roundIndex',
        'status', 'visibility', 'lastEvent', 'createdAt', 'updatedAt'
      ]) &&
      data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 64 && data.roomId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 && data.roomCode.matches('^[A-Z0-9\\-]+$') &&
      data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 && data.hostId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 60 &&
      data.hostScore is int && data.hostScore >= 0 && data.hostScore <= 1000000 &&
      data.guestId is string && data.guestId.size() >= 1 && data.guestId.size() <= 128 && data.guestId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 60 &&
      data.guestScore is int && data.guestScore >= 0 && data.guestScore <= 1000000 &&
      data.category is string && data.category.size() >= 5 && data.category.size() <= 15 &&
      (data.category == 'songs' || data.category == 'movies' || data.category == 'celebrities') &&
      data.roundIndex is int && data.roundIndex >= 0 && data.roundIndex <= 20 &&
      data.status is string && data.status.size() >= 6 && data.status.size() <= 12 &&
      (data.status == 'waiting' || data.status == 'active' || data.status == 'completed') &&
      data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
      data.lastEvent is string && data.lastEvent.size() >= 1 && data.lastEvent.size() <= 160 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Collection: /leaderboard/{userId}
    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && existing().visibility == 'public';
      allow list: if isSignedIn() && existing().visibility == 'public';

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidLeaderboardEntry(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidLeaderboardEntry(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'editorialTitle', 'score', 'streak',
          'badgesCount', 'tokens', 'unlockedBadges', 'unlockedRewards', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // Collection: /rooms/{roomId}
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && existing().visibility == 'public';
      allow list: if isSignedIn() && existing().visibility == 'public';

      allow create: if isVerifiedUser() &&
        isValidId(roomId) &&
        isValidMultiplayerRoom(incoming()) &&
        incoming().roomId == roomId &&
        incoming().hostId == request.auth.uid &&
        incoming().guestId == 'NONE' &&
        incoming().status == 'waiting' &&
        incoming().createdAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(roomId) &&
        isValidMultiplayerRoom(incoming()) &&
        existing().status != 'completed' &&
        incoming().roomId == existing().roomId &&
        incoming().roomCode == existing().roomCode &&
        incoming().hostId == existing().hostId &&
        incoming().hostName == existing().hostName &&
        incoming().category == existing().category &&
        incoming().createdAt == existing().createdAt && (
          // Action 1: Challenger joins a waiting room
          (
            existing().status == 'waiting' &&
            incoming().status == 'active' &&
            incoming().guestId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'guestId', 'guestName', 'status', 'lastEvent', 'updatedAt'
            ])
          ) ||
          // Action 2: Host or Challenger advances round / updates score
          (
            (request.auth.uid == existing().hostId || request.auth.uid == existing().guestId) &&
            incoming().guestId == existing().guestId &&
            incoming().guestName == existing().guestName &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hostScore', 'guestScore', 'roundIndex', 'status', 'lastEvent', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }
  }
}
